{
  "uid": "primeev-agent-perf",
    "title": "PrimeEV — Agent Performance",
    "tags": ["primeev", "agent"],
    "schemaVersion": 36,
    "version": 2,
    "refresh": "30s",
    "time": { "from": "now-7d", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Total Interactions",
        "type": "stat",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "rawSql": "SELECT count() AS interactions FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp)",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": { "steps": [{ "value": 0, "color": "blue" }] }
          }
        }
      },
      {
        "id": 2,
        "title": "Total Cost (USD)",
        "type": "stat",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "rawSql": "SELECT round(sum(cost_usd), 4) AS total_cost FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp)",
            "format": "table"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
      },
      {
        "id": 3,
        "title": "Avg Latency (ms)",
        "type": "stat",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "rawSql": "SELECT round(avg(total_latency_ms), 0) AS avg_latency FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp)",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 10000, "color": "yellow" },
                { "value": 30000, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Error Count",
        "type": "stat",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "rawSql": "SELECT countIf(had_error = 1) AS errors FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp)",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1, "color": "yellow" },
                { "value": 5, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Total Tokens Used",
        "type": "stat",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "rawSql": "SELECT sum(input_tokens + output_tokens) AS total_tokens FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp)",
            "format": "table"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 6,
        "title": "Avg Tool Calls / Request",
        "type": "stat",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "rawSql": "SELECT round(avg(tool_call_count), 1) AS avg_tools FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp)",
            "format": "table"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 7,
        "title": "Interactions Over Time",
        "type": "timeseries",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
        "targets": [
          {
            "rawSql": "SELECT toStartOfHour(timestamp) AS time, count() AS interactions FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
        }
      },
      {
        "id": 8,
        "title": "Latency Over Time (ms)",
        "type": "timeseries",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
        "targets": [
          {
            "rawSql": "SELECT toStartOfHour(timestamp) AS time, 'avg' AS metric, round(avg(total_latency_ms), 0) AS value FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
            "format": "table"
          },
          {
            "rawSql": "SELECT toStartOfHour(timestamp) AS time, 'p95' AS metric, round(quantile(0.95)(total_latency_ms), 0) AS value FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
            "format": "table"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
        "transformations": [{ "id": "prepareTimeSeries", "options": { "format": "multi" } }]
      },
      {
        "id": 9,
        "title": "Cost Per Hour (USD)",
        "type": "timeseries",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
        "targets": [
          {
            "rawSql": "SELECT toStartOfHour(timestamp) AS time, round(sum(cost_usd), 6) AS cost FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
            "format": "table"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "lineWidth": 2, "fillOpacity": 20 } } }
      },
      {
        "id": 10,
        "title": "Token Usage Over Time",
        "type": "timeseries",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
        "targets": [
          {
            "rawSql": "SELECT toStartOfHour(timestamp) AS time, 'input' AS token_type, sum(input_tokens) AS tokens FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
            "format": "table"
          },
          {
            "rawSql": "SELECT toStartOfHour(timestamp) AS time, 'output' AS token_type, sum(output_tokens) AS tokens FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
            "format": "table"
          },
          {
            "rawSql": "SELECT toStartOfHour(timestamp) AS time, 'cache_read' AS token_type, sum(cache_read_tokens) AS tokens FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
            "format": "table"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 1 } } },
        "transformations": [{ "id": "prepareTimeSeries", "options": { "format": "multi" } }]
      },
      {
        "id": 11,
        "title": "Interactions Table (recent)",
        "type": "table",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
        "targets": [
          {
            "rawSql": "SELECT timestamp, sub_agent, input_tokens, output_tokens, round(cost_usd, 6) AS cost_usd, total_latency_ms, ttft_ms, tool_call_count, had_error FROM primeev_telemetry.agent_interactions WHERE $__timeFilter(timestamp) ORDER BY timestamp DESC LIMIT 50",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "had_error" },
              "properties": [
                { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }] } },
                { "id": "custom.displayMode", "value": "color-background" }
              ]
            }
          ]
        }
      }
    ]
}
